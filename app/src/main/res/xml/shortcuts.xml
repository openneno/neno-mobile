<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面图标长按菜单 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="com.openneno.neno.action.VOICE"
            android:targetPackage="com.openneno.neno"
            android:targetClass="com.openneno.neno.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="compose"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_compose"
        android:shortcutShortLabel="@string/shortcut_compose"
        android:shortcutLongLabel="@string/shortcut_compose">
        <intent
            android:action="com.openneno.neno.action.COMPOSE"
            android:targetPackage="com.openneno.neno"
            android:targetClass="com.openneno.neno.MainActivity" />
    </shortcut>
</shortcuts>
